{
  "name": "stock-analysis-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local stock research, strategy testing and explicitly reviewed trading workspace",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config frontend/vite.config.js",
    "dev:api": "node --watch backend/server.js",
    "setup:analysis": "node scripts/setup-analysis.mjs",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js",
    "start": "node scripts/dev.mjs --production",
    "test": "node --test frontend/src/*.test.js backend/*.test.js",
    "test:analysis": "node scripts/test-analysis.mjs",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "demo:generate": "node scripts/generate-demo.mjs",
    "build:demo": "node scripts/generate-demo.mjs && vite build --config frontend/vite.config.js --mode demo"
  },
  "dependencies": {
    "@stoqey/ib": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "lightweight-charts": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
