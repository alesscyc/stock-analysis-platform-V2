# Local services have no authentication. Do not expose them to untrusted networks.
API_PORT=3001
ANALYSIS_PORT=8000
ANALYSIS_BASE_URL=http://127.0.0.1:8000
ANALYSIS_TIMEOUT_MS=90000
YAHOO_TIMEOUT_SECONDS=12

# Optional symbol suggestions. Direct ticker entry does not need a key.
FINNHUB_API_KEY=

# Existing IB Gateway / TWS, with API socket access enabled.
# 7497 is a common TWS paper port; IB itself determines real vs paper trading.
# Nothing is submitted unless the user explicitly confirms an order.
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=17
# Optional fixed order-routing account. Display-account selection does not change it.
IB_ACCOUNT=
IB_REQUEST_TIMEOUT_MS=8000
IB_SNAPSHOT_MAX_AGE_MS=90000

# Optional OpenAI-compatible provider; data is sent to this provider when chatting.
# Example https://api.openai.com/v1, or your own local compatible endpoint.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
CHAT_TIMEOUT_MS=60000

# Optional full path to Python when creating the analysis virtual environment.
# PYTHON=C:/Python312/python.exe
